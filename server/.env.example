# Optional when using the default local Ollama configuration.
OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=local_qwen3_1024

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Local Qwen defaults for the Ollama service in docker-compose.yaml.
# Providers must be listed in BUNDLED_*_PROVIDERS in server/main.py.
MEM0_DEFAULT_LLM_PROVIDER=ollama
MEM0_DEFAULT_LLM_MODEL=qwen3:4b-instruct-2507-q8_0
# Set to 0 to let Ollama use its own generation limit.
MEM0_DEFAULT_LLM_MAX_TOKENS=0
MEM0_DEFAULT_EMBEDDER_PROVIDER=ollama
MEM0_DEFAULT_EMBEDDER_MODEL=qwen3-embedding:0.6b-q8_0
# Qwen3 Embedding 0.6B produces 1024-dimensional vectors by default.
MEM0_DEFAULT_EMBEDDING_DIMS=1024
OLLAMA_BASE_URL=http://ollama:11434

# Docker network shared with local AI clients.
MEM0_SHARED_NETWORK=local_ai

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
